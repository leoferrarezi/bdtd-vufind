<?php
  // BDTD: o dARK ID vem dos metadados coletados (dc.identifier.dark, ex.: ark:/79692/0013000007b2c).
  // Só vira link para o resolvedor n2t.net quando tem a forma de um ARK; sempre com escape.
  $darkId = trim((string)$this->driver->getDarkID());
?>
<?php if (preg_match('#^ark:/?[0-9a-z]+/[\w./~=+-]+$#i', $darkId)): ?>
  <a href="<?=$this->escapeHtmlAttr('https://n2t.net/' . $darkId)?>" target="_blank" rel="noopener"><?=$this->escapeHtml($darkId)?></a>
<?php else: ?>
  <?=$this->escapeHtml($darkId)?>
<?php endif; ?>
